{
  "name": "@next/eslint-plugin-next",
  "version": "15.4.2-canary.20",
  "description": "ESLint plugin for Next.js.",
  "main": "dist/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "license": "MIT",
  "repository": {
    "url": "vercel/next.js",
    "directory": "packages/eslint-plugin-next"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "fast-glob": "3.3.1"
  },
  "devDependencies": {
    "@types/eslint": "^9.6.1"
  },
  "scripts": {
    "dev": "pnpm build",
    "build": "pnpm build:cjs && pnpm build:esm && pnpm types",
    "build:cjs": "swc -d dist src --config-file .swcrc.cjs",
    "build:esm": "swc -d dist/esm src --config-file .swcrc.esm",
    "types": "tsc src/index.ts --skipLibCheck --declaration --emitDeclarationOnly --declarationDir dist --esModuleInterop --allowSyntheticDefaultImports",
    "prepublishOnly": "cd ../../ && turbo run build"
  }
}
